generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(200)
  createdAt DateTime @default(now())
}
